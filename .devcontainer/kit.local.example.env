# Copy to .devcontainer/kit.local.env (gitignored) to build and run under a
# name that is never committed: a template ships PROJECT_NAME=changeme in
# kit.env, and its own checkout still needs a real one. run.sh reads this file
# after kit.env, and accepts PROJECT_NAME here and nothing else.
#
# A project made from the kit has no need of it: set the name in kit.env with
# `python3 .devcontainer/set-project-name.py <name>` and commit it.
PROJECT_NAME=changeme
