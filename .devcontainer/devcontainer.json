{
  "name": "helen-triages (sandboxed)",
  "initializeCommand": "bash .devcontainer/run.sh --build-only",
  "image": "helen-triages-devcontainer",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace",
  "mounts": [
    "source=helen-triages-claude-config,target=/state/claude-config,type=volume",
    "source=helen-triages-bundle-cache,target=/state/bundle,type=volume"
  ],
  "remoteEnv": {
    "AGENT_GH_TOKEN": "${localEnv:AGENT_GH_TOKEN}"
  },
  "updateRemoteUserUID": false,
  "forwardPorts": [4001, 4002],
  "portsAttributes": {
    "4001": { "label": "jekyll-local" },
    "4002": { "label": "jekyll-prod" }
  },
  "postCreateCommand": "bundle install",
  "customizations": {
    "vscode": {
      "extensions": ["Shopify.ruby-lsp"]
    }
  }
}
