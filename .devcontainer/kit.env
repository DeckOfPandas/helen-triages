# What goes into helen-triages' Claude Code image, and how run.sh starts it.
# Plain KEY=value lines; run.sh validates each and rebuilds when one changes.
# The kit's own copy of this file documents every key.

PROJECT_NAME=helen-triages

NODE_MAJOR=24

# Jekyll. Gems live in the helen-triages-bundle-cache volume; bundle install
# once after the first run.
WITH_RUBY=1
RUBY_VERSION=3.3

# The screenshot harness (scripts/browser/, tools/dev/) and its tests.
WITH_PLAYWRIGHT=1
PLAYWRIGHT_VERSION=1.63.0

# requirements.txt: PyYAML for the data tests.
WITH_PY_REQS=1

# helen-triages' block: 5000 to 5010, the same number inside and out.
# jekyll-local is 5000, jekyll-prod 5001; sessions serve branches on the rest.
PORTS="5000:5000 5001:5001 5002:5002 5003:5003 5004:5004 5005:5005 5006:5006 5007:5007 5008:5008 5009:5009 5010:5010"

EXTRA_ALLOWED_DOMAINS=""

MOUNT_DOTFILES=1
