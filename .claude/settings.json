{
  "permissions": {
    "allow": [
      "Bash(pytest *)",
      "Bash(python3 -m pytest *)",
      "Bash(.node-runtime/node/bin/node --test *)",
      "Bash(curl -s \"https://api.github.com/repos/DeckOfPandas/helen-triages/*)",
      "Bash(.gh-runtime/bin/gh auth status)",
      "Bash(.gh-runtime/bin/gh issue *)"
    ],
    "deny": [
      "Bash(chmod *)",
      "Bash(chown *)",
      "Bash(sudo *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-destructive-git.py\"",
            "if": "Bash(git *)",
            "timeout": 20,
            "statusMessage": "Checking for destructive git"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-main-branch.py\"",
            "if": "Bash(git *)",
            "timeout": 20,
            "statusMessage": "Checking branch is not main"
          }
        ]
      }
    ]
  }
}
