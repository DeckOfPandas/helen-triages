{
  "permissions": {
    "blockReadsOutsideWorkingDirectories": true,
    "additionalDirectories": [
      "/workspace/.claude/worktrees",
      "/workspace/.node-runtime"
    ],
    "allow": [
      "Read(//dev/null)",
      "Edit(//dev/null)",
      "Bash(pytest *)",
      "Bash(python3 -m pytest *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git blame *)",
      "Bash(git ls-tree *)",
      "Bash(git check-ignore *)",
      "Bash(git commit -F *)",
      "Bash(sh scripts/gh-agent.sh issue list *)",
      "Bash(sh scripts/gh-agent.sh issue view *)",
      "Bash(sh scripts/gh-agent.sh issue comment *)",
      "Bash(sh scripts/gh-agent.sh issue create *)",
      "Bash(sh scripts/gh-agent.sh issue edit *)",
      "Bash(sh scripts/gh-agent.sh pr list *)",
      "Bash(sh scripts/gh-agent.sh pr view *)",
      "Bash(sh scripts/gh-agent.sh pr diff *)",
      "Bash(sh scripts/gh-agent.sh pr create *)",
      "Bash(sh scripts/gh-agent.sh repo clone *)",
      "Bash(sh scripts/gh-agent.sh pr comment *)",
      "Bash(sh scripts/gh-read.sh *)",
      "Bash(sh scripts/gh-write.sh *)",
      "Bash(sh scripts/github-public-status.sh *)",
      "Bash(sh scripts/git-push-agent.sh *)",
      "Bash(sh scripts/git-fetch-agent.sh *)",
      "Bash(sh scripts/git-clone-agent.sh *)",
      "Bash(sh scripts/git-fetch-main.sh)",
      "Bash(git branch --show-current)",
      "Bash(git add -- *)",
      "Bash(git merge origin/main)",
      "Bash(python3 scripts/verify.py)",
      "Bash(node --test)",
      "Bash(sh scripts/browser/install.sh)",
      "Bash(sh scripts/browser/build.sh)",
      "Bash(sh scripts/browser/serve.sh)",
      "Bash(sh scripts/browser/shoot.sh *)",
      "Bash(sh scripts/browser/crop.sh *)",
      "Bash(sh scripts/browser/styles.sh *)",
      "Bash(sh scripts/browser/gaps.sh *)",
      "Bash(sh scripts/browser/click-crop.sh *)"
    ],
    "deny": [
      "Edit(//workspace/.node-runtime/**)",
      "Bash(chmod *)",
      "Bash(chown *)",
      "Bash(sudo *)",
      "Bash(gh pr merge *)",
      "Bash(.gh-runtime/bin/gh pr merge *)",
      "Bash(sh scripts/gh-agent.sh pr merge *)",
      "Bash(sh scripts/gh-agent.sh pr review *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-ground-truth.py\"",
            "timeout": 20,
            "statusMessage": "Reading where this session is"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-destructive-git.py\"",
            "if": "Bash(git *)",
            "timeout": 20,
            "statusMessage": "Checking for destructive git"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-main-branch.py\"",
            "if": "Bash(git *)",
            "timeout": 20,
            "statusMessage": "Checking branch is not main"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-sed.py\"",
            "timeout": 20,
            "statusMessage": "Checking for sed"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-awk.py\"",
            "timeout": 20,
            "statusMessage": "Checking for awk"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-token-expansion.py\"",
            "timeout": 20,
            "statusMessage": "Checking for token expansion"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-inline-script.py\"",
            "timeout": 20,
            "statusMessage": "Checking for inline scripts"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-unanalyzable-bash.py\"",
            "timeout": 20,
            "statusMessage": "Checking the command can be analysed"
          }
        ]
      }
    ]
  }
}
