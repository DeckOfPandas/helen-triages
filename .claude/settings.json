{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-destructive-git.py\"",
            "if": "Bash(git *)",
            "statusMessage": "Checking for destructive git",
            "timeout": 20,
            "type": "command"
          },
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-main-branch.py\"",
            "if": "Bash(git *)",
            "statusMessage": "Checking branch is not main",
            "timeout": 20,
            "type": "command"
          },
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-token-expansion.py\"",
            "statusMessage": "Checking for token exposure",
            "timeout": 20,
            "type": "command"
          },
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-github-burst.py\"",
            "statusMessage": "Checking for a burst of GitHub issues or PRs",
            "timeout": 20,
            "type": "command"
          },
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-git-output.py\"",
            "statusMessage": "Checking git diff options",
            "timeout": 20,
            "type": "command"
          },
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-dev-null.py\"",
            "statusMessage": "Checking /dev/null is only a redirection",
            "timeout": 20,
            "type": "command"
          },
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-unanalyzable-bash.py\"",
            "statusMessage": "Checking the command can be analysed",
            "timeout": 20,
            "type": "command"
          },
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-inline-script.py\"",
            "statusMessage": "Checking for inline programs",
            "timeout": 20,
            "type": "command"
          },
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-sed.py\"",
            "statusMessage": "Checking for sed",
            "timeout": 20,
            "type": "command"
          },
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-awk.py\"",
            "statusMessage": "Checking for awk",
            "timeout": 20,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-ground-truth.py\"",
            "statusMessage": "Reading where this session is",
            "timeout": 20,
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "additionalDirectories": [
      "/opt",
      "/workspace/.claude/worktrees"
    ],
    "allow": [
      "Bash(python3 -m pytest)",
      "Bash(python3 -m pytest -q)",
      "Bash(sh scripts/pytest.sh *)",
      "Bash(python3 tools/kit/build.py)",
      "Bash(python3 tools/kit/build.py --check)",
      "Bash(python3 tools/kit/sync.py)",
      "Bash(python3 tools/kit/sync.py --dry-run)",
      "Bash(python3 tools/kit/sync.py --status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git blame *)",
      "Bash(git ls-tree *)",
      "Bash(git check-ignore *)",
      "Bash(git branch --show-current)",
      "Bash(git add -- *)",
      "Bash(git commit -F *)",
      "Bash(git merge origin/main)",
      "Bash(sh scripts/git-fetch-main.sh)",
      "Bash(sh scripts/git-diff-main-checkout.sh)",
      "Bash(sh scripts/git-diff-main-checkout.sh *)",
      "Bash(sh scripts/git-push-agent.sh *)",
      "Bash(sh scripts/git-fetch-agent.sh *)",
      "Bash(sh scripts/git-clone-agent.sh *)",
      "Bash(node tools/dev/shoot.js *)",
      "Bash(node tools/dev/slice-png.js *)",
      "Bash(node tools/dev/crop.js *)",
      "Bash(node tools/dev/styles.js *)",
      "Bash(node tools/dev/gaps.js *)",
      "Bash(python3 tools/dev/inkbox.py *)",
      "Bash(sh scripts/gh-read.sh *)",
      "Bash(sh scripts/gh-write.sh *)",
      "Bash(sh scripts/github-public-status.sh *)",
      "Bash(sh scripts/check-link.sh *)",
      "Bash(sh scripts/main-ci-status.sh)",
      "Bash(sh scripts/main-ci-status.sh *)",
      "Bash(sh scripts/kit-ports.sh)",
      "Bash(sh scripts/git-nested.sh *)",
      "Bash(sh scripts/gh-agent.sh issue list *)",
      "Bash(sh scripts/gh-agent.sh issue view *)",
      "Bash(sh scripts/gh-agent.sh issue comment *)",
      "Bash(sh scripts/gh-agent.sh issue create *)",
      "Bash(sh scripts/gh-agent.sh issue edit *)",
      "Bash(sh scripts/gh-agent.sh pr list *)",
      "Bash(sh scripts/gh-agent.sh pr view *)",
      "Bash(sh scripts/gh-agent.sh pr diff *)",
      "Bash(sh scripts/gh-agent.sh pr create *)",
      "Bash(sh scripts/gh-agent.sh pr comment *)",
      "Read(//dev/null)",
      "Edit(//dev/null)",
      "Read(//workspace/.claude/worktrees/**)",
      "Read(//opt/**)",
      "Bash(python3 scripts/verify.py)",
      "Bash(node --test)",
      "Bash(sh scripts/browser/install.sh)",
      "Bash(sh scripts/browser/build.sh)",
      "Bash(sh scripts/browser/serve.sh)",
      "Bash(sh scripts/browser/capture.sh)",
      "Bash(sh scripts/browser/shoot.sh *)",
      "Bash(sh scripts/browser/crop.sh *)",
      "Bash(sh scripts/browser/styles.sh *)",
      "Bash(sh scripts/browser/gaps.sh *)",
      "Bash(sh scripts/browser/click-crop.sh *)"
    ],
    "blockReadsOutsideWorkingDirectories": true,
    "deny": [
      "Read(./.claude/settings.local.json)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./scripts/github.local.conf)",
      "Write(./scripts/github.local.conf)",
      "Edit(//workspace/scripts/github.local.conf)",
      "Write(//workspace/scripts/github.local.conf)",
      "Bash(chmod *)",
      "Bash(chown *)",
      "Bash(sudo *)",
      "Bash(gh pr merge *)",
      "Bash(sh scripts/gh-agent.sh pr merge *)",
      "Bash(sh scripts/gh-agent.sh pr review *)",
      "Edit(//opt/**)",
      "Bash(.gh-runtime/bin/gh pr merge *)"
    ]
  },
  "worktree": {
    "baseRef": "head"
  }
}
