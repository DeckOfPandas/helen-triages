# Jekyll build output
_site/
_site_prod/
.jekyll-cache/
.jekyll-metadata
.sass-cache/

# Unpublished. One entry per site's drafts collection — the pattern is the
# collection's source directory name, so RENAMING A COLLECTION SILENTLY
# UN-IGNORES IT. That happened once: `_drafts/` became `_food_drafts/` in the
# mono-repo migration and 221 unpublished recipes stopped being ignored without
# a word. tests/test_site_config.py now checks this against _config.yml.
_food_drafts/
_cocktail_drafts/

# Ruby
vendor/
.bundle/

# Python (test suite)
__pycache__/
.pytest_cache/
.venv/
*.pyc

# Node (local runtime only, for `node --test` -- not part of the site or its
# build; downloaded from nodejs.org, extracted here rather than installed
# system-wide, so it stays out of version control)
.node-runtime/

# OS
.DS_Store
Thumbs.db

# Local workflow
*Zone.Identifier
model_instructions/
